{
  "name": "next-template",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev --webpack",
    "build": "next build --webpack",
    "start": "node server.js",
    "lint": "eslint",
    "production-deploy": "npm run postinstall && prisma7 migrate deploy && npm run build",
    "production-build": "npm run postinstall && npm run build",
    "analyze": "cross-env ANALYZE=true next build --webpack",
    "db:deploy": "prisma7 migrate deploy",
    "db:generate": "prisma7 generate",
    "db:studio": "prisma7 studio",
    "auth:generate": "npx @better-auth/cli@latest generate --config ./lib/auth/auth.ts --yes",
    "typecheck": "tsc --noEmit",
    "reset-password": "node scripts/reset-password.js",
    "sync-template": "git fetch upstream && git merge upstream/main"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@better-auth/passkey": "^1.7.21",
    "@better-auth/prisma-adapter": "^1.7.21",
    "@ducanh2912/next-pwa": "^10.2.9",
    "@hookform/resolvers": "^7.0.6",
    "@marsidev/react-turnstile": "^1.6.3",
    "@prisma/prisma7": "^7.10.1",
    "@tanstack/react-query": "^5.107.1",
    "better-auth": "^1.7.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^18.0.10",
    "framer-motion": "^14.12.0",
    "lucide-react": "^1.72.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "nextjs-toploader": "^3.9.17",
    "nodemailer": "^10.5.0",
    "react": "^19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-qr-code": "^2.2.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@next/bundle-analyzer": "^16.4.6",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/react-query-devtools": "^5.107.1",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-config-next": "^16.4.6",
    "jimp": "^1.6.1",
    "pg": "^8.23.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  },
  "overrides": {
    "serialize-javascript": "^7.1.4",
    "zod": "$zod",
    "minimatch": "^11.0.4"
  }
}
